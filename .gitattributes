# Normalize line endings: LF in repo and working copies for text files.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.cfg text eol=lf

# Windows-only assets keep CRLF
*.bat text eol=crlf
